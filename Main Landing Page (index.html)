                        <div class="stat-label">Per Unit</div>
                    </div>
                    <div class="stat">
                        <div class="stat-number">30<span class="stat-unit">sec</span></div>
                        <div class="stat-label">Refresh Time</div>
                    </div>
                    <div class="stat">
                        <div class="stat-number">5.0<span class="stat-unit">pH</span></div>
