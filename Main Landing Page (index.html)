        <div class="container">
            <div class="solution-content">
                <div class="section-header">
                    <h2 class="section-title">Simple, Effective Solution</h2>
                    <p class="section-subtitle">Engineered for real-world use</p>
                </div>
                <div class="solution-features">
                    <div class="feature">
                        <div class="feature-icon">
                            <i class="fas fa-tint"></i>
                        </div>
                        <div class="feature-text">
                            <h4>Waterless Design</h4>
                            <p>Pre-applied pH 5.0 lotion means no water needed. Use anywhere, anytime.</p>
                        </div>
                    </div>
                    <div class="feature">
                        <div class="feature-icon">
                            <i class="fas fa-ruler-combined"></i>
                        </div>
                        <div class="feature-text">
                            <h4>55mm Easy-Entry Opening</h4>
                            <p>Wider than standard condoms for effortless application in any state.</p>
                        </div>
                    </div>
                    <div class="feature">
                        <div class="feature-icon">
                            <i class="fas fa-leaf"></i>
                        </div>
                        <div class="feature-text">
                            <h4>Natural Formulation</h4>
                            <p>Aloe Vera + Citricidal (Grapefruit Seed Extract) - effective yet gentle.</p>
                        </div>
                    </div>
                    <div class="feature">
                        <div class="feature-icon">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <div class="feature-text">
                            <h4>Discreet & Portable</h4>
                            <p>Single foil pouch (condom-pack size) fits in wallet or pocket.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="solution-visual">
                <div class="usage-steps">
                    <div class="step">
                        <div class="step-number">1</div>
                        <div class="step-icon">
                            <i class="fas fa-box-open"></i>
                        </div>
                        <div class="step-title">Open</div>
                        <div class="step-desc">Tear open foil pouch</div>
                    </div>
                    <div class="step-arrow">
                        <i class="fas fa-arrow-right"></i>
                    </div>
                    <div class="step">
                        <div class="step-number">2</div>
                        <div class="step-icon">
                            <i class="fas fa-hand-paper"></i>
                        </div>
                        <div class="step-title">Apply</div>
                        <div class="step-desc">Slip on easily (15 seconds)</div>
                    </div>
                    <div class="step-arrow">
                        <i class="fas fa-arrow-right"></i>
                    </div>
                    <div class="step">
                        <div class="step-number">3</div>
                        <div class="step-icon">
                            <i class="fas fa-recycle"></i>
                        </div>
                        <div class="step-title">Refresh</div>
                        <div class="step-desc">Gentle motion (15 seconds)</div>
                    </div>
                    <div class="step-arrow">
                        <i class="fas fa-arrow-right"></i>
                    </div>
                    <div class="step">
                        <div class="step-number">4</div>
                        <div class="step-icon">
