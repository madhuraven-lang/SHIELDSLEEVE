                    <div class="specs-table">
                        <div class="spec-row">
                            <div class="spec-label">Material</div>
                            <div class="spec-value">Medical-grade Polyurethane (Latex-free)</div>
                        </div>
                        <div class="spec-row">
                            <div class="spec-label">Opening Diameter</div>
                            <div class="spec-value">55mm (57% wider than standard condoms)</div>
                        </div>
                        <div class="spec-row">
                            <div class="spec-label">Length</div>
                            <div class="spec-value">120mm</div>
                        </div>
                        <div class="spec-row">
                            <div class="spec-label">Lotion Volume</div>
                            <div class="spec-value">0.5ml ±0.05ml precision coating</div>
                        </div>
                        <div class="spec-row">
                            <div class="spec-label">pH Level</div>
                            <div class="spec-value">5.0 (Matches healthy skin pH)</div>
                        </div>
                        <div class="spec-row">
                            <div class="spec-label">Active Ingredients</div>
                            <div class="spec-value">Aloe Vera (70%), Glycerin (15%), Citricidal (10%), Preservative (5%)</div>
                        </div>
                        <div class="spec-row">
                            <div class="spec-label">Packaging</div>
                            <div class="spec-value">Single foil pouch, 70mm × 40mm</div>
                        </div>
                        <div class="spec-row">
                            <div class="spec-label">Shelf Life</div>
                            <div class="spec-value">36 months</div>
                        </div>
                        <div class="spec-row">
                            <div class="spec-label">Manufacturing Partner</div>
                            <div class="spec-value">HLL Lifecare (Hindustan Latex)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
