                        <button id="notify-btn" class="notify-btn">Notify Me <i class="fas fa-bell"></i></button>
                    </div>
                    <p class="notify-note">We respect your privacy. Unsubscribe at any time.</p>
                </div>
                <div class="notify-visual">
                    <div class="notify-badge">
                        <i class="fas fa-rocket"></i>
                    </div>
                </div>
            </div>
        </div>
