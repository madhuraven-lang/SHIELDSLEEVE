// Initialize active state on page load
document.addEventListener('DOMContentLoaded', () => {
    // Trigger scroll event to set initial active state
    window.dispatchEvent(new Event('scroll'));
    
    // Add active style to active nav links
    const style = document.createElement('style');
    style.textContent = `
        .nav-link.active {
            color: #1a73e8 !important;
            font-weight: 600;
        }
    `;
    document.head.appendChild(style);
});

// Form input enhancements
document.querySelectorAll('input, textarea, select').forEach(input => {
    // Add focus effect
    input.addEventListener('focus', function() {
        this.parentElement.classList.add('focused');
    });
    
    input.addEventListener('blur', function() {
        if (!this.value) {
            this.parentElement.classList.remove('focused');
        }
    });
    
    // Add floating label effect for contact form
    if (input.parentElement.classList.contains('form-group')) {
        const label = document.createElement('label');
        label.textContent = input.placeholder;
        label.style.cssText = `
            position: absolute;
            top: -10px;
            left: 12px;
            font-size: 12px;
            color: #1a73e8;
            background: white;
            padding: 0 4px;
            display: none;
        `;
        
        input.placeholder = '';
        input.parentElement.style.position = 'relative';
        input.parentElement.appendChild(label);
        
        input.addEventListener('focus', function() {
            label.style.display = 'block';
        });
        
        input.addEventListener('blur', function() {
            if (!this.value) {
                label.style.display = 'none';
            }
        });
    }
});

// Add stats counter animation
function animateStats() {
    const statNumbers = document.querySelectorAll('.stat-number');
    
    statNumbers.forEach(stat => {
        const target = parseInt(stat.textContent.replace(/[^0-9]/g, ''));
        const duration = 2000;
        const step = target / (duration / 16);
        let current = 0;
        
        const timer = setInterval(() => {
            current += step;
            if (current >= target) {
                current = target;
                clearInterval(timer);
            }
            
            if (stat.classList.contains('stat-percent')) {
                stat.textContent = Math.floor(current) + '%';
            } else {
                stat.textContent = Math.floor(current);
            }
        }, 16);
    });
}

// Trigger stats animation when section is in view
const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            animateStats();
            observer.unobserve(entry.target);
        }
    });
}, { threshold: 0.5 });

// Observe problem section for stats animation
const problemSection = document.querySelector('.problem');
if (problemSection) {
    observer.observe(problemSection);
}
